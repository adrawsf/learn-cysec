---
// Search.astro
---

<div class="mb-8">
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-text-muted">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </div>
    <input 
      type="text" 
      id="search-input" 
      class="w-full bg-surface border border-border rounded-lg pl-10 pr-4 py-3 text-white placeholder-text-muted focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors"
      placeholder="Search notes by title, description, or tags..."
    />
  </div>
  
  <div class="flex flex-wrap gap-4 mt-4" id="filters">
    <select id="category-filter" class="bg-surface border border-border text-sm rounded px-3 py-1.5 text-white focus:outline-none focus:border-brand">
      <option value="">All Categories</option>
      <!-- Categories populated via JS -->
    </select>
    
    <select id="status-filter" class="bg-surface border border-border text-sm rounded px-3 py-1.5 text-white focus:outline-none focus:border-brand">
      <option value="">All Statuses</option>
      <option value="completed">Completed</option>
      <option value="learning">Learning</option>
      <option value="planned">Planned</option>
    </select>
    
    <select id="difficulty-filter" class="bg-surface border border-border text-sm rounded px-3 py-1.5 text-white focus:outline-none focus:border-brand">
      <option value="">All Difficulties</option>
      <option value="beginner">Beginner</option>
      <option value="intermediate">Intermediate</option>
      <option value="advanced">Advanced</option>
    </select>
  </div>
</div>

<script>
  // Simple client-side search logic
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
    const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;
    const difficultyFilter = document.getElementById('difficulty-filter') as HTMLSelectElement;
    
    const noteCards = document.querySelectorAll('.note-card-wrapper');
    
    // Populate categories dynamically
    const categories = new Set();
    noteCards.forEach(card => {
      const cat = card.getAttribute('data-category');
      if (cat) categories.add(cat);
    });
    
    categories.forEach(cat => {
      const option = document.createElement('option');
      option.value = cat as string;
      option.textContent = (cat as string).toUpperCase();
      categoryFilter.appendChild(option);
    });

    const filterNotes = () => {
      const searchTerm = input.value.toLowerCase();
      const category = categoryFilter.value;
      const status = statusFilter.value;
      const difficulty = difficultyFilter.value;

      noteCards.forEach(card => {
        const c = card as HTMLElement;
        const text = c.getAttribute('data-search') || '';
        const cardCat = c.getAttribute('data-category');
        const cardStatus = c.getAttribute('data-status');
        const cardDiff = c.getAttribute('data-difficulty');
        
        const matchText = text.includes(searchTerm);
        const matchCat = category === '' || cardCat === category;
        const matchStatus = status === '' || cardStatus === status;
        const matchDiff = difficulty === '' || cardDiff === difficulty;
        
        if (matchText && matchCat && matchStatus && matchDiff) {
          c.style.display = 'block';
        } else {
          c.style.display = 'none';
        }
      });
    };

    if (input) input.addEventListener('input', filterNotes);
    if (categoryFilter) categoryFilter.addEventListener('change', filterNotes);
    if (statusFilter) statusFilter.addEventListener('change', filterNotes);
    if (difficultyFilter) difficultyFilter.addEventListener('change', filterNotes);
  });
</script>
