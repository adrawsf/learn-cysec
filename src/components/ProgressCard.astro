---
interface Props {
  percentage: number;
  totalNotes: number;
  completedTopics: number;
  totalTopics: number;
}

const { percentage, totalNotes, completedTopics, totalTopics } = Astro.props;
---

<div class="bg-surface border border-border rounded-xl p-6 relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute -right-10 -top-10 w-32 h-32 bg-brand/5 rounded-full blur-2xl"></div>
  
  <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div>
      <h3 class="text-text-muted font-mono text-sm uppercase tracking-wider mb-1">Overall Progress</h3>
      <div class="flex items-baseline gap-2">
        <span class="text-4xl font-bold text-white">{percentage}%</span>
        <span class="text-brand text-sm font-medium">completed</span>
      </div>
    </div>
    
    <div class="w-full md:w-auto flex-grow max-w-md">
      <div class="h-2 w-full bg-bg rounded-full overflow-hidden border border-border/50">
        <div 
          class="h-full bg-brand rounded-full relative" 
          style={`width: ${percentage}%`}
        >
          <div class="absolute inset-0 bg-white/20 w-full animate-[shimmer_2s_infinite]"></div>
        </div>
      </div>
    </div>
    
    <div class="grid grid-cols-2 gap-4 md:gap-8 w-full md:w-auto">
      <div>
        <span class="block text-2xl font-bold text-white">{totalNotes}</span>
        <span class="text-xs text-text-muted font-mono uppercase">Notes</span>
      </div>
      <div>
        <span class="block text-2xl font-bold text-white">{completedTopics}<span class="text-text-muted text-lg">/{totalTopics}</span></span>
        <span class="text-xs text-text-muted font-mono uppercase">Modules</span>
      </div>
    </div>
  </div>
</div>
