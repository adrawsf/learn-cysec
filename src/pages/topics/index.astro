---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS } from '../../config/topics';
import { getTopicsStats } from '../../utils/progress';

const topicStats = await getTopicsStats(TOPICS);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<BaseLayout title="Topics">
  <header class="mb-12">
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-4">
      Knowledge Domains
    </h1>
    <p class="text-text-muted max-w-2xl">
      Browse my notes by specific cybersecurity domains and topics.
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {topicStats.map(topic => (
      <a href={`${base}topics/${topic.slug}`} class="block group">
        <div class="bg-surface border border-border hover:border-brand/50 rounded-xl p-6 transition-all h-full flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-white group-hover:text-brand transition-colors">{topic.name}</h2>
            <span class="bg-brand/10 text-brand text-xs px-2 py-1 rounded font-mono font-medium">
              {topic.notesCount} {topic.notesCount === 1 ? 'note' : 'notes'}
            </span>
          </div>
          <p class="text-text-muted text-sm flex-grow">
            {topic.description}
          </p>
          <div class="mt-6 flex items-center text-sm font-medium text-brand opacity-0 group-hover:opacity-100 transition-opacity">
            Explore domain &rarr;
          </div>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
